{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiniOS Studio",
  "version": "0.1.0",
  "identifier": "studio.winios.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WiniOS Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../icons/icon.ico"]
  }
}
